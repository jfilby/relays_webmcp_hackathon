// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "core"]
}

// Project specific

// Batch

model BatchJob {
  id                           String               @id @default(cuid())
  instanceId                   String?              @map("instance_id")
  instance                     Instance?            @relation(fields: [instanceId], references: [id])
  userProfileId                String?              @map("user_profile_id")
  userProfile                  UserProfile?         @relation(fields: [userProfileId], references: [id])
  runInATransaction            Boolean              @map("run_in_a_transaction")
  status                       String               @db.Char(1)
  statusReason                 String?              @map("status_reason") @db.Char(3)
  progressPct                  Int?                 @map("progress_pct")
  message                      String?
  jobType                      String               @map("job_type")
  refModel                     String?              @map("ref_model")
  refId                        String?              @map("ref_id")
  parameters                   String?              // Stringified JSON
  created                      DateTime             @default(now())
  updated                      DateTime             @updatedAt

  @@index([refId])
  @@map("batch_job")
  @@schema("public")
}

// Email lists

model EmailList {
  id                           String               @id @default(cuid())
  status                       String               @db.Char(1)
  name                         String               @unique
  created                      DateTime             @default(now())
  updated                      DateTime             @updatedAt

  ofEmailListUsers             EmailListUser[]

  @@map("email_list")
  @@schema("public")
}

model EmailListUser {
  id                           String               @id @default(cuid())
  emailListId                  String               @map("email_list_id")
  emailList                    EmailList            @relation(fields: [emailListId], references: [id])
  // A subscribed user profile (for signed-in users), or an email address (for
  // visitors who aren't signed-in). One of the two must be set.
  userProfileId                String?              @map("user_profile_id")
  userProfile                  UserProfile?         @relation(fields: [userProfileId], references: [id])
  email                        String?
  created                      DateTime             @default(now())
  updated                      DateTime             @updatedAt

  @@unique([emailListId, userProfileId])
  @@unique([emailListId, email])
  @@map("email_list_user")
  @@schema("public")
}

// Relays: Profiles

model Profile {
  // Professional identity on Relays, extending the core UserProfile. The type
  // field distinguishes a human from an AI agent (both are first-class users).
  id                           String               @id @default(cuid())
  publicId                     String               @map("public_id") @unique
  userProfileId                String               @map("user_profile_id") @unique
  userProfile                  UserProfile          @relation(fields: [userProfileId], references: [id])
  type                         String               @db.Char(1)   // H (human), A (agent)
  status                       String               @db.Char(1)
  displayName                  String               @map("display_name")
  headline                     String?
  bio                          String?              @db.Text
  location                     String?
  website                      String?
  avatar                       String?
  isPublic                     Boolean              @map("is_public")
  availabilityStatus           String               @map("availability_status") @db.Char(1)   // A (available), B (busy), U (unavailable)
  isVerified                   Boolean              @map("is_verified")
  verifiedAt                   DateTime?            @map("verified_at")
  embedding                    Unsupported("vector(1536)")?   // Search embedding (pgvector); written via raw SQL, see prisma/search-setup.sql
  created                      DateTime             @default(now())
  updated                      DateTime             @updatedAt

  ofConnectionsSent            Connection[]         @relation("connectionFrom")
  ofConnectionsReceived        Connection[]         @relation("connectionTo")
  ofOrganizationMemberships    OrganizationMember[]
  ofProjectMemberships         ProjectMember[]
  ofPlansCreated               CollaborationPlan[]  @relation("planCreatedBy")
  ofPlansTargeted              CollaborationPlan[]  @relation("planTargeted")
  ofProfileLinks              ProfileLink[]
  ofProfileSkills             ProfileSkill[]
  ofEndorsementsGiven         Endorsement[]        @relation("endorsementFrom")
  ofEndorsementsReceived      Endorsement[]        @relation("endorsementTo")
  ofDiscussPosts               DiscussPost[]
  ofDiscussComments            DiscussComment[]     @relation("discussCommentAuthor")
  ofProjectInterests          ProjectInterest[]

  @@map("profile")
  @@schema("public")
}

// Relays: Networking

model Connection {
  // A directed link between two profiles (e.g. a connection request). While
  // pending only the from->to edge exists; on acceptance a symmetric active
  // edge is implied. status: P (pending), A (active), R (rejected), B (blocked).
  id                           String               @id @default(cuid())
  fromProfileId                String               @map("from_profile_id")
  fromProfile                  Profile              @relation("connectionFrom", fields: [fromProfileId], references: [id])
  toProfileId                  String               @map("to_profile_id")
  toProfile                    Profile              @relation("connectionTo", fields: [toProfileId], references: [id])
  status                       String               @db.Char(1)
  origin                       String               @db.Char(1)   // How the connection started: S (search), P (project), C (collaboration plan), I (introduction)
  message                      String?
  acceptedAt                   DateTime?            @map("accepted_at")
  created                      DateTime             @default(now())
  updated                      DateTime             @updatedAt

  @@unique([fromProfileId, toProfileId])
  @@index([toProfileId, status])
  @@map("connection")
  @@schema("public")
}

// Relays: Organizations

model Organization {
  // A team/company that promotes projects. Organisations are instances
  // (instanceType 'P') and their Relays-specific details live here.
  id                           String               @id @default(cuid())
  instanceId                   String               @map("instance_id") @unique
  instance                     Instance             @relation(fields: [instanceId], references: [id])
  name                         String
  website                      String?
  description                  String?              @db.Text
  logo                         String?
  size                         String?              @db.Char(1)   // Employee band: S (small), M (medium), L (large), X (enterprise)
  industry                     String?
  status                       String               @db.Char(1)
  created                      DateTime             @default(now())
  updated                      DateTime             @updatedAt

  ofOrganizationMembers        OrganizationMember[]
  ofProjects                   Project[]

  @@map("organization")
  @@schema("public")
}

model OrganizationMember {
  id                           String               @id @default(cuid())
  organizationId               String               @map("organization_id")
  organization                 Organization         @relation(fields: [organizationId], references: [id])
  profileId                    String               @map("profile_id")
  profile                      Profile              @relation(fields: [profileId], references: [id])
  role                         String               @db.Char(1)   // O (owner), M (member)
  status                       String               @db.Char(1)
  created                      DateTime             @default(now())

  @@unique([organizationId, profileId])
  @@map("organization_member")
  @@schema("public")
}

// Relays: Projects

model Project {
  // Details for a project instance, including how it is presented/promoted.
  id                           String               @id @default(cuid())
  publicId                     String               @map("public_id") @unique
  instanceId                   String               @map("instance_id") @unique
  instance                     Instance             @relation(fields: [instanceId], references: [id])
  organizationId               String?              @map("organization_id")
  organization                 Organization?        @relation(fields: [organizationId], references: [id])
  tagline                      String?
  description                  String?              @db.Text
  image                        String?
  techStack                    String[]             @map("tech_stack")
  stage                        String?              @db.Char(1)   // I (idea), A (alpha), B (beta), G (generally available)
  isOpenToCollaborators        Boolean              @map("is_open_to_collaborators")
  isPromoted                   Boolean              @map("is_promoted")
  embedding                    Unsupported("vector(1536)")?   // Search embedding (pgvector); written via raw SQL, see prisma/search-setup.sql
  status                       String               @db.Char(1)
  created                      DateTime             @default(now())
  updated                      DateTime             @updatedAt

  ofProjectMembers             ProjectMember[]
  ofDiscussPosts               DiscussPost[]
  ofProjectInterests           ProjectInterest[]
  ofCollaborationPlans         CollaborationPlan[]
  ofProjectUrls                ProjectUrl[]

  @@map("project")
  @@schema("public")
}

model ProjectMember {
  id                           String               @id @default(cuid())
  projectId                    String               @map("project_id")
  project                      Project              @relation(fields: [projectId], references: [id])
  profileId                    String               @map("profile_id")
  profile                      Profile              @relation(fields: [profileId], references: [id])
  role                         String               @db.Char(1)   // O (owner), C (collaborator)
  status                       String               @db.Char(1)
  created                      DateTime             @default(now())

  @@unique([projectId, profileId])
  @@map("project_member")
  @@schema("public")
}

model ProjectUrl {
  // A typed external URL for a project (website, repository, docs, demo,
  // social, etc.). More flexible than fixed website/repo fields.
  id                           String               @id @default(cuid())
  projectId                    String               @map("project_id")
  project                      Project              @relation(fields: [projectId], references: [id])
  kind                         String               @db.Char(1)   // W (website), R (repository), D (docs), E (demo), S (social), X (other)
  url                          String
  label                        String?
  created                      DateTime             @default(now())
  updated                      DateTime             @updatedAt

  @@unique([projectId, url])
  @@map("project_url")
  @@schema("public")
}

// Relays: Collaboration

model CollaborationPlan {
  // A plan to collaborate on a project, proposed by one profile and optionally
  // targeted at another. status: D (draft), O (open), A (accepted), C (completed),
  // X (cancelled).
  id                           String               @id @default(cuid())
  createdByProfileId           String               @map("created_by_profile_id")
  createdByProfile             Profile              @relation("planCreatedBy", fields: [createdByProfileId], references: [id])
  projectId                    String               @map("project_id")
  project                      Project              @relation(fields: [projectId], references: [id])
  targetProfileId              String?              @map("target_profile_id")   // The other party to collaborate with, if any
  targetProfile                Profile?             @relation("planTargeted", fields: [targetProfileId], references: [id])
  status                       String               @db.Char(1)
  title                        String
  description                  String?              @db.Text
  rolesNeeded                  String[]             @map("roles_needed")
  commitmentLevel              String?              @map("commitment_level") @db.Char(1)   // H (hours/week), W (weeks), M (months)
  compensation                 String?              @db.Char(1)   // N (none), E (equity), P (paid)
  deliverables                 String?              @db.Text
  startBy                      DateTime?            @map("start_by")
  created                      DateTime             @default(now())
  updated                      DateTime             @updatedAt
  completedAt                  DateTime?            @map("completed_at")
  ofPlanSteps                  PlanStep[]

  @@index([projectId])
  @@index([targetProfileId])
  @@map("collaboration_plan")
  @@schema("public")
}

// Relays: Skills

model Skill {
  // A named capability that profiles list (humans and agents alike) and that
  // endorsements attest to. Catalog entries are global.
  id                           String               @id @default(cuid())
  name                         String               @unique
  category                     String?              @db.Char(1)   // T (technology), D (domain), C (creative)
  status                       String               @db.Char(1)
  created                      DateTime             @default(now())
  updated                      DateTime             @updatedAt

  ofProfileSkills              ProfileSkill[]
  ofEndorsements               Endorsement[]

  @@map("skill")
  @@schema("public")
}

model ProfileSkill {
  // Associates a profile with a Skill it claims, with an optional proficiency.
  id                           String               @id @default(cuid())
  profileId                    String               @map("profile_id")
  profile                      Profile              @relation(fields: [profileId], references: [id])
  skillId                      String               @map("skill_id")
  skill                        Skill                @relation(fields: [skillId], references: [id])
  level                        String?              @db.Char(1)   // B (beginner), I (intermediate), A (advanced), E (expert)
  created                      DateTime             @default(now())
  updated                      DateTime             @updatedAt

  @@unique([profileId, skillId])
  @@index([skillId])
  @@map("profile_skill")
  @@schema("public")
}

model ProfileLink {
  // An external link belonging to a profile (website, GitHub, LinkedIn,
  // repository, MCP endpoint, etc.). Agents especially need machine-readable
  // pointers here.
  id                           String               @id @default(cuid())
  profileId                    String               @map("profile_id")
  profile                      Profile              @relation(fields: [profileId], references: [id])
  kind                         String               @db.Char(1)   // W (website), G (github), L (linkedin), R (repository), M (MCP endpoint), X (other)
  url                          String
  handle                       String?
  isVerified                   Boolean              @map("is_verified")
  created                      DateTime             @default(now())
  updated                      DateTime             @updatedAt

  @@unique([profileId, url])
  @@map("profile_link")
  @@schema("public")
}

model Endorsement {
  // Social proof of a profile's proficiency with a Skill, given by another
  // profile. Works identically for agents (capability endorsements).
  id                           String               @id @default(cuid())
  fromProfileId                String               @map("from_profile_id")
  fromProfile                  Profile              @relation("endorsementFrom", fields: [fromProfileId], references: [id])
  toProfileId                  String               @map("to_profile_id")
  toProfile                    Profile              @relation("endorsementTo", fields: [toProfileId], references: [id])
  skillId                      String               @map("skill_id")
  skill                        Skill                @relation(fields: [skillId], references: [id])
  comment                      String?
  created                      DateTime             @default(now())

  @@unique([toProfileId, skillId, fromProfileId])
  @@index([fromProfileId])
  @@map("endorsement")
  @@schema("public")
}


model DiscussPost {
  // A discussion topic posted by a profile, optionally attached to a project.
  // Comments on the post live in DiscussComment.
  id                           String               @id @default(cuid())
  authorProfileId              String               @map("author_profile_id")
  authorProfile                Profile              @relation(fields: [authorProfileId], references: [id])
  publicId                     String               @map("public_id") @unique
  projectId                    String?              @map("project_id")
  project                      Project?             @relation(fields: [projectId], references: [id])
  body                         String               @db.Text
  title                        String
  status                       String               @db.Char(1)
  created                      DateTime             @default(now())
  updated                      DateTime             @updatedAt

  ofDiscussComments            DiscussComment[]

  @@index([authorProfileId])
  @@index([projectId])
  @@index([created])
  @@map("discuss_post")
  @@schema("public")
}

model DiscussComment {
  // A comment on a DiscussPost.
  id                           String               @id @default(cuid())
  postId                       String               @map("post_id")
  post                         DiscussPost          @relation(fields: [postId], references: [id])
  authorProfileId              String               @map("author_profile_id")
  authorProfile                Profile              @relation("discussCommentAuthor", fields: [authorProfileId], references: [id])
  body                         String               @db.Text
  status                       String               @db.Char(1)
  publicId                     String               @map("public_id") @unique
  parentCommentId              String?              @map("parent_comment_id")
  parentComment                DiscussComment?      @relation("discussCommentReplies", fields: [parentCommentId], references: [id])
  ofDiscussCommentReplies      DiscussComment[]     @relation("discussCommentReplies")
  created                      DateTime             @default(now())
  updated                      DateTime             @updatedAt

  @@index([postId])
  @@index([authorProfileId])
  @@index([parentCommentId])
  @@map("discuss_comment")
  @@schema("public")
}

model ProjectInterest {
  // Marks a profile as interested in / watching a project (stars analogue);
  // makes project promotion measurable and feeds recommendations.
  id                           String               @id @default(cuid())
  profileId                    String               @map("profile_id")
  profile                      Profile              @relation(fields: [profileId], references: [id])
  projectId                    String               @map("project_id")
  project                      Project              @relation(fields: [projectId], references: [id])
  created                      DateTime             @default(now())

  @@unique([profileId, projectId])
  @@index([projectId])
  @@map("project_interest")
  @@schema("public")
}

// Relays: Collaboration plan steps

model PlanStep {
  // One step of a CollaborationPlan, executed in sequence; mirrors the
  // workflow/steps pattern used elsewhere.
  id                           String               @id @default(cuid())
  planId                       String               @map("plan_id")
  plan                         CollaborationPlan    @relation(fields: [planId], references: [id])
  seq                          Int                  // Sequence number within the plan
  title                        String
  description                  String?              @db.Text
  status                       String               @db.Char(1)
  created                      DateTime             @default(now())
  updated                      DateTime             @updatedAt

  @@unique([planId, seq])
  @@map("plan_step")
  @@schema("public")
}

// Relays: Notifications

model Notification {
  // An in-app notification for a user, referencing another record via
  // refModel/refId (the same polymorphic pattern as BatchJob).
  id                           String               @id @default(cuid())
  userProfileId                String               @map("user_profile_id")
  userProfile                  UserProfile          @relation(fields: [userProfileId], references: [id])
  type                         String
  refModel                     String?              @map("ref_model")
  refId                        String?              @map("ref_id")
  readAt                       DateTime?            @map("read_at")
  created                      DateTime             @default(now())

  @@index([userProfileId])
  @@index([refId])
  @@map("notification")
  @@schema("public")
}
